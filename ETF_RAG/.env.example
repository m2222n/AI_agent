OPENAI_API_KEY=your-key-here

# KRX Data Marketplace (https://data.krx.co.kr 회원가입 필요)
KRX_ID=your-krx-id
KRX_PW=your-krx-password

# Cohere Rerank (https://dashboard.cohere.com — 무료 1000건/월)
# 설정 시 하이브리드 검색 후 cross-encoder 재정렬 자동 활성화
COHERE_API_KEY=your-cohere-api-key

# LangSmith (https://smith.langchain.com — 무료 5000 traces/월)
# 설정 시 LangGraph 에이전트의 모든 호출이 자동 트레이싱됨
# OpenDart API (https://opendart.fss.or.kr — 무료 10,000건/일)
DART_API_KEY=your-dart-api-key

LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=etf-rag-chatbot

# --- 인증 / 사용자 DB (FastAPI 백엔드) ---
# 미설정 시 로컬 sqlite(etf_rag_users.db) 사용. 프로덕션(Railway)은 Postgres.
# DATABASE_URL=postgresql://user:pass@host:5432/etf_rag_users
# JWT_SECRET — 프로덕션 필수 (랜덤 긴 문자열). 미설정 시 dev 기본값 + 경고.
JWT_SECRET=change-this-in-production
JWT_EXPIRE_MINUTES=10080

# --- CORS (프로덕션) ---
# 프론트 배포 origin. 미설정 시 "*"(dev). 예: https://your-frontend.up.railway.app
# CORS_ORIGINS=https://your-frontend.example.com
