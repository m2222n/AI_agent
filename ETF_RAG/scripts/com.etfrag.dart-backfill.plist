<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.etfrag.dart-backfill</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/m2222n/Work/Personal/AI_agent/ETF_RAG/scripts/backfill_financials.sh</string>
    </array>

    <!-- 매주 월요일 19:00 실행 (기존 수집 18:30 이후, DART 재무제표 주간 갱신) -->
    <!-- 백필 완료 후에는 신규 공시만 스캔하므로 주 1회 충분 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>19</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- 환경변수 -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <!-- 로그 -->
    <key>StandardOutPath</key>
    <string>/Users/m2222n/Work/Personal/AI_agent/ETF_RAG/logs/dart_backfill_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/m2222n/Work/Personal/AI_agent/ETF_RAG/logs/dart_backfill_stderr.log</string>
</dict>
</plist>
