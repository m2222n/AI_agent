<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.etfrag.daily-collect</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/m2222n/Work/Personal/AI_agent/ETF_RAG/scripts/daily_collect.sh</string>
    </array>

    <!-- 매일 18:00 실행 (장마감 후) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>18</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- 환경변수 -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <!-- 로그 -->
    <key>StandardOutPath</key>
    <string>/Users/m2222n/Work/Personal/AI_agent/ETF_RAG/logs/launchd_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/m2222n/Work/Personal/AI_agent/ETF_RAG/logs/launchd_stderr.log</string>
</dict>
</plist>
